<!DOCTYPE html>
<html>
<head><title>Utenti</title></head>
<body>
  <h1>Lista Utenti</h1>
  <form action="/users" method="POST">
    <input type="text" name="name" placeholder="Nome" required>
    <input type="email" name="email" placeholder="Email" required>
    <input type="url" name="imgLink" placeholder="Link" required>
    <input type="text" name="price" placeholder="Prezzo" required>
    <input type="text" name="number" placeholder="numero" required>
    <button type="submit">Aggiungi</button>
  </form>
  <ul>
    <% users.forEach(user => { %>
      <li>
        <%= user.name %> - <%= user.email %> - <img src="<%= user.imgLink %>" width="20%" height="20%"> - <%= user.price %> - <%= user.number%>
        <form action="/users/delete/<%= user.id %>" method="POST" style="display:inline;">
          <button type="submit">Elimina</button>
        </form>
        <form action="/users/increment/<%= user.id %>" method="POST" style="display: inline;">
          <button type="submit">Compra</button>
        </form>
      </li>
    <% }) %>
  </ul>
  <a href="/">Torna alla home</a>
</body>
</html&gt